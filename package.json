{
  "name": "golf-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node --use-system-ca --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "agent": "node --use-system-ca server/agent.mjs",
    "start": "node --use-system-ca server/index.js",
    "seed": "node --use-system-ca server/seed.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "concurrently": "^9.2.5",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.24.8",
    "pino": "^10.4.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "vite": "^6.0.3"
  }
}
