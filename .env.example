# Local .env AND Vercel Project → Settings → Environment Variables
# (Vercel does NOT read your local .env file)

# Atlas URI — database name must be in the path before ?
# Example: ...mongodb.net/modus-edge?retryWrites=true&w=majority&authSource=admin
MONGODB_URI=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=modus2024

# Leave blank on Vercel (same-origin /api)
VITE_API_URL=

PORT=3001
